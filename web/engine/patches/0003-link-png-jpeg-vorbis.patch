diff --git a/image_png.c b/image_png.c
index 6b226af0..e4cd6dd0 100644
--- a/image_png.c
+++ b/image_png.c
@@ -123,6 +123,9 @@ static dllfunction_t png14funcs[] =
 // Handle for PNG DLL
 dllhandle_t png_dll = NULL;
 dllhandle_t png14_dll = NULL;
+#ifdef __EMSCRIPTEN__
+void *Bako_PNG_Symbol(const char *name); // image_png_static.c
+#endif
 
 
 /*
@@ -171,6 +174,20 @@ qbool PNG_OpenLibrary (void)
 	if (png_dll)
 		return true;
 
+#ifdef __EMSCRIPTEN__
+	{
+		const dllfunction_t *f;
+		for (f = pngfuncs; f->name; f++)
+			if (!(*f->funcvariable = Bako_PNG_Symbol(f->name)))
+				return false;
+		for (f = png14funcs; f->name; f++)
+			if (!(*f->funcvariable = Bako_PNG_Symbol(f->name)))
+				return false;
+		png_dll = png14_dll = (dllhandle_t)dllnames; // not a real handle: never freed (see PNG_CloseLibrary)
+		return true;
+	}
+#endif
+
 	// Load the DLL
 	if(!Sys_LoadDependency (dllnames, &png_dll, pngfuncs))
 		return false;
@@ -193,6 +210,9 @@ Unload the PNG DLL
 */
 void PNG_CloseLibrary (void)
 {
+#ifdef __EMSCRIPTEN__
+	return; // statically linked
+#endif
 	Sys_FreeLibrary (&png14_dll);
 	Sys_FreeLibrary (&png_dll);
 }
diff --git a/image_png_static.c b/image_png_static.c
new file mode 100644
index 00000000..5e010844
--- /dev/null
+++ b/image_png_static.c
@@ -0,0 +1,27 @@
+/*
+ * BakersfieldQuake browser build: libpng is linked statically (emscripten's libpng port), but this
+ * DarkPlaces only loads libpng with dlopen, which a browser can't do. PNG_OpenLibrary() asks here instead.
+ * A separate file so <png.h> doesn't clash with image_png.c's own declarations.
+ */
+#ifdef __EMSCRIPTEN__
+#include <png.h>
+#include <string.h>
+
+void *Bako_PNG_Symbol(const char *name);
+#define BAKO_PNG(f) if (!strcmp(name, #f)) return (void *)f;
+void *Bako_PNG_Symbol(const char *name)
+{
+	BAKO_PNG(png_set_sig_bytes) BAKO_PNG(png_sig_cmp) BAKO_PNG(png_create_read_struct)
+	BAKO_PNG(png_create_write_struct) BAKO_PNG(png_create_info_struct) BAKO_PNG(png_read_info)
+	BAKO_PNG(png_set_compression_level) BAKO_PNG(png_set_filter) BAKO_PNG(png_set_expand)
+	BAKO_PNG(png_set_palette_to_rgb) BAKO_PNG(png_set_tRNS_to_alpha) BAKO_PNG(png_set_gray_to_rgb)
+	BAKO_PNG(png_set_filler) BAKO_PNG(png_set_IHDR) BAKO_PNG(png_set_packing) BAKO_PNG(png_set_bgr)
+	BAKO_PNG(png_set_interlace_handling) BAKO_PNG(png_read_update_info) BAKO_PNG(png_read_image)
+	BAKO_PNG(png_read_end) BAKO_PNG(png_destroy_read_struct) BAKO_PNG(png_destroy_write_struct)
+	BAKO_PNG(png_set_read_fn) BAKO_PNG(png_set_write_fn) BAKO_PNG(png_get_valid)
+	BAKO_PNG(png_get_rowbytes) BAKO_PNG(png_get_channels) BAKO_PNG(png_get_bit_depth)
+	BAKO_PNG(png_get_IHDR) BAKO_PNG(png_access_version_number) BAKO_PNG(png_write_info)
+	BAKO_PNG(png_write_row) BAKO_PNG(png_write_end) BAKO_PNG(png_set_longjmp_fn)
+	return NULL;
+}
+#endif

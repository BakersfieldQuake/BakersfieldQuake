// generated by build_bklan_tv.py + update_bklan_tv_daniel.py: the TV clips (skin of a clip's chunk j = first + j)
float BKTV_CLIPS = 12;
float BKTV_CHUNK = 6.2;		// seconds a chunk plays (62 new frames at 10 fps)
float(float v) BKTV_First =
{
	if (v == 0) return 1;
	if (v == 1) return 6;
	if (v == 2) return 11;
	if (v == 3) return 13;
	if (v == 4) return 21;
	if (v == 5) return 22;
	if (v == 6) return 24;
	if (v == 7) return 26;
	if (v == 8) return 30;
	if (v == 9) return 31;
	if (v == 10) return 33;
	if (v == 11) return 35;
	return 1;
};

float(float v) BKTV_Chunks =
{
	if (v == 0) return 5;
	if (v == 1) return 5;
	if (v == 2) return 2;
	if (v == 3) return 8;
	if (v == 4) return 1;
	if (v == 5) return 2;
	if (v == 6) return 2;
	if (v == 7) return 4;
	if (v == 8) return 1;
	if (v == 9) return 2;
	if (v == 10) return 2;
	if (v == 11) return 2;
	return 1;
};

string(float v) BKTV_Sound =
{
	if (v == 0) return "bklan/tv_0.wav";
	if (v == 1) return "bklan/tv_1.wav";
	if (v == 2) return "bklan/tv_2.wav";
	if (v == 3) return "bklan/tv_3.wav";
	if (v == 4) return "bklan/tv_4.wav";
	if (v == 5) return "bklan/tv_5.wav";
	if (v == 6) return "bklan/tv_6.wav";
	if (v == 7) return "bklan/tv_7.wav";
	if (v == 8) return "bklan/tv_8.wav";
	if (v == 9) return "bklan/tv_9.wav";
	if (v == 10) return "bklan/tv_10.wav";
	if (v == 11) return "bklan/tv_11.wav";
	return "bklan/tv_0.wav";
};

void() BKTV_Precache =
{
	if (bktv_precached)
		return;
	bktv_precached = TRUE;
	precache_model ("progs/bk_tvscr.md3");
	precache_sound ("bklan/tv_0.wav");
	precache_sound ("bklan/tv_1.wav");
	precache_sound ("bklan/tv_2.wav");
	precache_sound ("bklan/tv_3.wav");
	precache_sound ("bklan/tv_4.wav");
	precache_sound ("bklan/tv_5.wav");
	precache_sound ("bklan/tv_6.wav");
	precache_sound ("bklan/tv_7.wav");
	precache_sound ("bklan/tv_8.wav");
	precache_sound ("bklan/tv_9.wav");
	precache_sound ("bklan/tv_10.wav");
	precache_sound ("bklan/tv_11.wav");
};

 	for (i = 0;i < 4;i++)
 	{
+		if (!probe && !(lastavailable & (1<<i)))
+			continue;
 		if (qXInputGetState && qXInputGetState(i, &state) == S_OK)
 		{
 			xinputavailable |= 1<<i;

void(float nums) prox_spawn =
{
	local entity dropitem;

	dropitem = spawn();
	dropitem.origin = (self.origin + '0 0 3');
	dropitem.dmg = 1;
	dropitem.health = nums;
	dropitem.think = weapon_proximity_gun;
	dropitem.nextthink = (time + 0.1);
};

float(vector from, vector to) Dot =
{
	return ((((from_x * to_x) + (from_y * to_y)) + (from_z * to_z)));
};

void(vector slope) pitch_roll_for_slope =
{
	local vector new_angles;
	local vector new_angles2;
	local vector old_forward;
	local vector old_right;
	local float dot;
	local float mod;
	local vector oldang;

	makevectors(self.angles);
	oldang = self.angles;
	old_forward = v_forward;
	old_right = v_right;
	if ((slope == VEC_ORIGIN))
	{
		traceline(self.origin, (self.origin - '0 0 300'), TRUE, self);
		if (((trace_fraction > 0.05) && (self.movetype == MOVETYPE_STEP)))
		{
			self.flags = (self.flags - (self.flags & FL_ONGROUND));
		}
		if ((trace_fraction == 1))
		{
			return;
		}
		slope = trace_plane_normal;
	}
	new_angles = vectoangles(slope);
	new_angles_x = (90 - new_angles_x) * -1;
	new_angles2 = VEC_ORIGIN;
	makevectors(new_angles2);
	mod = v_forward * old_right;
	if ((mod < 0))
	{
		mod = 1;
	}
	else
	{
		mod = -1;
	}
	dot = v_forward * old_forward;
	self.angles_x = (dot * new_angles_x);
	if (((self.netname == "blood") && (self.angles_x != oldang_x)))
	{
		remove(self);
	}
	self.angles_z = (((1 - fabs(dot)) * new_angles_x) * mod);
};

void() exp_check_collision =
{
	if ((pointcontents((self.origin + '0 0 15')) == CONTENT_SOLID))
	{
		setorigin(self, (self.origin - '0 0 17'));
		self.velocity = '0 0 -40';
	}
	if ((pointcontents((self.origin + '15 0 0')) == CONTENT_SOLID))
	{
		setorigin(self, (self.origin - '20 0 0'));
	}
	if ((pointcontents((self.origin + '0 15 0')) == CONTENT_SOLID))
	{
		setorigin(self, (self.origin - '0 20 0'));
	}
	if ((pointcontents((self.origin + '-15 0 0')) == CONTENT_SOLID))
	{
		setorigin(self, (self.origin - '-20 0 0'));
	}
	if ((pointcontents((self.origin + '0 -15 0')) == CONTENT_SOLID))
	{
		setorigin(self, (self.origin - '0 -20 0'));
	}
	if ((pointcontents(self.origin) == CONTENT_WATER))
	{
		self.velocity = '0 0 10';
	}
};

float(entity ent) checkUPS_forward =
{
	local float DotComp;

	makevectors(ent.angles);
	DotComp = Dot(v_forward, ent.velocity);
	return (DotComp);
};

float(entity ent) checkUPS_right =
{
	local float DotComp;

	makevectors(ent.angles);
	DotComp = Dot(v_right, ent.velocity);
	return (DotComp);
};

float(entity ent, float speed) checkSpeed =
{
	local float DotCompFwd;
	local float DotCompBck;
	local float DotCompRight;
	local float DotCompLeft;

	makevectors(ent.angles);
	DotCompFwd = Dot(v_forward, ent.velocity);
	if ((DotCompFwd < speed))
	{
		DotCompFwd = 0;
	}
	DotCompBck = Dot(v_forward, ent.velocity);
	if ((DotCompBck > (0 - speed)))
	{
		DotCompBck = 0;
	}
	DotCompLeft = Dot(v_right, ent.velocity);
	if ((DotCompLeft > (0 - speed)))
	{
		DotCompLeft = 0;
	}
	DotCompRight = Dot(v_right, ent.velocity);
	if ((DotCompRight < speed))
	{
		DotCompRight = 0;
	}
	if ((((!DotCompFwd && !DotCompBck) && !DotCompLeft) && !DotCompRight))
	{
		return (0);
	}
	else
	{
		return (TRUE);
	}
};

float(string s) returnsurface =
{
	if (((((((((s == "wizwood1_2") || (s == "wizwood1_3")) || (s == "wizwood1_4")) || (s == "wizwood1_5")) || (s == "wizwood1_6")) || (s == "wizwood1_7")) || (s == "wizwood1_8")) || (s == "wood1_1")))
	{
		return (GROUND);
	}
	else
	{
		if ((((((((((((((((((((((s == "ground1_1") || (s == "ground1_2")) || (s == "ground1_5")) || (s == "ground1_5")) || (s == "ground1_5b")) || (s == "ground1_6")) || (s == "ground1_6b")) || (s == "ground1_7")) || (s == "ground_1")) || (s == "wgrnd1_6")) || (s == "wgrnd1_5")) || (s == "wgrnd1_8")) || (s == "wgrass1_1")) || (s == "grave01_1")) || (s == "grave01_3")) || (s == "grave03_1")) || (s == "grave03_2")) || (s == "grave03_3")) || (s == "grave03_3")) || (s == "grave03_4")) || (s == "grave03_5")))
		{
			return (GROUND);
		}
		else
		{
			if (((((((((s == "rock1_2") || (s == "rock3_2")) || (s == "rock3_7")) || (s == "rock3_8")) || (s == "rock4_1")) || (s == "rock4_2")) || (s == "rock5_2")) || (s == "rock2")))
			{
				return (ROCK);
			}
			else
			{
				if ((((((((((((((((((s == "ecop1_6") || (s == "plat_top1")) || (s == "plat_side1")) || (s == "wmet1_1")) || (s == "metal2_5")) || (s == "metal2_6")) || (s == "metal2_4")) || (s == "metal1_3")) || (s == "met5_1")) || (s == "ecop1_2")) || (s == "wizmet1_2")) || (s == "grate01")) || (s == "plat_top2")) || (s == "wmet2_1")) || (s == "{speedbz_grid1")) || (s == "{grate01")) || (s == "{ladder5th")))
				{
					return (METAL);
				}
				else
				{
					if ((((s == "meat1_5") || (s == "meat1_4")) || (s == "meat1_2")))
					{
						return (MEAT);
					}
					else
					{
						if ((s == "black"))
						{
							return (VOID);
						}
					}
				}
			}
		}
	}
	return (0);
};

float world_has_q1_surfs;

// Probe once at worldspawn whether this BSP uses stock Quake 1 material/sky/evil_faces textures.
// High-poly custom BSP2 maps (e.g. bakersfielddowntown: 104k world faces, 0 matches) skip O(N)
// getsurfacenearpoint(world) scans while stock Q1 / Q1.5 maps stay 100% identical.
void() World_DetectQ1Surfaces =
{
	local float lo, hi, mid, n, step, i, mat;
	local string tex;

	tex = getsurfacetexture(world, 12000);
	if ((!tex || (tex == "")))
	{
		world_has_q1_surfs = TRUE;
		return;
	}
	lo = 12000;
	hi = 262144;
	while (((lo + 1) < hi))
	{
		mid = floor(((lo + hi) * 0.5));
		tex = getsurfacetexture(world, mid);
		if ((tex && (tex != "")))
		{
			lo = mid;
		}
		else
		{
			hi = mid;
		}
	}
	n = hi;
	step = floor((n / 512));
	if ((step < 1))
	{
		step = 1;
	}
	world_has_q1_surfs = FALSE;
	i = 0;
	while (i < n)
	{
		tex = getsurfacetexture(world, i);
		mat = returnsurface(tex);
		if ((mat > 0 && mat != VOID) || tex == "sky1" || tex == "sky4" || tex == "sky_base" || tex == "sky_curse1")
		{
			world_has_q1_surfs = TRUE;
			return;
		}
		if (tex == "altarb_1" || tex == "altarb_2" || tex == "dem4_1" || tex == "dem4_4" || tex == "dem5_3" || tex == "demc4_4")
		{
			world_has_q1_surfs = TRUE;
			return;
		}
		i = i + step;
	}
};


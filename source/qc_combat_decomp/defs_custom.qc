void() TimeRuneCheat =
{
	local entity dropitem;

	dropitem = spawn();
	dropitem.origin = self.origin;
	dropitem.dmg = 1;
	dropitem.health = 1;
	dropitem.think = item_artifact_timerune;
	dropitem.nextthink = (time + 0.1);
};

void() saw_spawn =
{
	local entity dropitem;

	dropitem = spawn();
	dropitem.origin = self.origin;
	dropitem.dmg = 1;
	dropitem.health = 1;
	dropitem.think = weapon_nailgun;
	dropitem.nextthink = (time + 0.1);
};


	self.idletimer = 0;
};

void() zombiek_charge =
{
	local float r;

	r = random();
	if (((self.model == "progs/mon_zombiek.mdl") || (self.model == "progs/mon_zombiek_onearm.mdl")))
	{
		if ((r < 0.3))
		{
			zombiek_atta1();
		}
		else
		{
			if ((self.idletimer < 3))
			{
				zombiek_jump1();
			}
		}
		self.idletimer = (self.idletimer + 1);
		if (((self.idletimer > 2) && (r > 0.6)))
		{
			zombiek_melee();
		}
	}
};


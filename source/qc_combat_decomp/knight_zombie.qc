void() zombiek_die =
{
	CeilSplat();
	CeilSplat();
	CeilSplat();
	CeilSplat();
	CeilSplat();
	sound7(self, CHAN_VOICE, "zombie/z_gib.wav", 1, ATTN_NORM, SNDSPD);
	sendParticle("blood_monster_gib", self.origin, VEC_ORIGIN, 1, 0);
	if ((self.model == "progs/mon_zombiek_onearm.mdl"))
	{
		ThrowGib("progs/gib_zarm.mdl", self.health);
	}
	else
	{
		if ((self.model == "progs/mon_zombiek_noarms.mdl"))
		{
			ThrowGib("progs/gib3.mdl", self.health);
		}
		else
		{
			if ((self.model == "progs/mon_zombiek.mdl"))
			{
				ThrowGib("progs/gib_zarm.mdl", self.health);
				ThrowGib("progs/gib_zarm.mdl", self.health);
			}
		}
	}
	ThrowHead("progs/h_zombiek.mdl", self.health);
	ThrowGib("progs/gib3.mdl", self.health);
	ThrowGib("progs/gib_zleg.mdl", self.health);
	ThrowGib("progs/gib_zleg.mdl", self.health);
};

void(entity attacker, float take) zombiek_pain =
{
	local float r;

	self.health = 60;
	if ((take < 9))
	{
		return;
	}
	if ((self.inpain == 2))
	{
		return;
	}
	if (((self.enemy.weapon == IT_CHAINSAW) || (self.enemy.weapon == IT_AXE)))
	{
		self.meleeattack = (self.meleeattack + 1);
	}
	if ((take >= 10))
	{
		if (((attacker.weapon == IT_AXE) || (attacker.weapon == IT_CHAINSAW)))
		{
			if (((self.model == "progs/mon_zombiek.mdl") && (self.meleeattack > 3)))
			{
				ThrowGib("progs/gib_zarm.mdl", self.health);
				self.model = "progs/mon_zombiek_onearm.mdl";
				setmodel(self, "progs/mon_zombiek_onearm.mdl");
				setsize(self, ZOMB_MIN, ZOMB_MAX);
			}
			else
			{
				if (((self.model == "progs/mon_zombiek_onearm.mdl") && (self.meleeattack > 5)))
				{
					ThrowGib("progs/gib_zarm.mdl", self.health);
					ThrowWeapon("progs/w_knightsword.mdl", self.health);
					self.goalentity = world;
					self.th_melee = SUB_Null;
					self.th_walk();
					self.model = "progs/mon_zombiek_noarms.mdl";
					setmodel(self, "progs/mon_zombiek_noarms.mdl");
					setsize(self, ZOMB_MIN, ZOMB_MAX);
				}
			}
			if (((self.meleeattack > 2) && (random() < 0.05)))
			{
				zombie_die();
			}
		}
	}
	if ((take >= 25))
	{
		if ((((!self.shocked && (self.enemy.weapon == IT_LIGHTNING)) && (take >= 30)) && (random() < 0.8)))
		{
			self.sticky = 0;
			zombie_die();
			return;
		}
		self.inpain = 2;
		zombiek_paine1();
		return;
	}
	if (self.inpain)
	{
		self.pain_finished = (time + 3);
		return;
	}
	if ((self.pain_finished > time))
	{
		self.inpain = 2;
		zombiek_paine1();
		return;
	}
	self.inpain = 1;
	r = random();
	if ((r < 0.25))
	{
		zombiek_paina1();
	}
	else
	{
		if ((r < 0.5))
		{
			zombiek_painb1();
		}
		else
		{
			if ((r < 0.75))
			{
				zombiek_painc1();
			}
			else
			{
				zombiek_paind1();
			}
		}
	}
};

void() zombiek_lay12 = [ 132, zombiek_paine13 ]

// Custom smooth classic Ranger (progs/player_id1.mdl) death animations & classic gibs.
// Frame constants live in player_deaths_frames.qc (auto-generated by build_player_deaths.py).

.float pd_anim;
.float pd_end_frame;
.float pd_gib_flags;
.vector pd_slide_vel;
.float pd_slide_t;

void() PD_Precache =
{
	registercvar("bm_death_anim", "0");
	precache_model("progs/h_player_id1.mdl");
	precache_model("progs/gib_id1_arm_l.mdl");
	precache_model("progs/gib_id1_arm_r.mdl");
	precache_model("progs/gib_id1_leg_l.mdl");
	precache_model("progs/gib_id1_leg_r.mdl");
};

void() PD_Reset =
{
	self.pd_anim = 0;
	self.pd_end_frame = 0;
	self.pd_gib_flags = 0;
	self.pd_slide_vel = '0 0 0';
	self.pd_slide_t = 0;
};

void() PD_PlayerCorpseFade =
{
	self.alpha = (self.alpha - 0.08);
	if ((self.alpha <= 0.05))
	{
		bodyque_clear();
		return;
	}
	self.think = PD_PlayerCorpseFade;
	self.nextthink = (time + 0.1);
};

void() PD_PlayerCorpseWait =
{
	if ((self.alpha <= 0))
		self.alpha = 1;
	self.think = PD_PlayerCorpseFade;
	self.nextthink = (time + 0.1);
};

void(string gibname, vector local_ofs, vector local_vel, float keep_colormap) PD_SpawnClassicGib =
{
	local entity g;
	local float gibsfadetime;

	makevectors(self.angles);
	g = spawn();
	g.origin = self.origin + (v_forward * local_ofs_x) + (v_right * (-local_ofs_y)) + ('0 0 1' * local_ofs_z);
	setmodel(g, gibname);
	setsize(g, '-8 -8 -8', '8 8 8');
	g.cansplash = TRUE;
	g.velocity = (v_forward * local_vel_x) + (v_right * (-local_vel_y)) + ('0 0 1' * local_vel_z);
	g.velocity = g.velocity + (self.velocity * 0.35);
	g.velocity_x = g.velocity_x + (crandom() * 35);
	g.velocity_y = g.velocity_y + (crandom() * 35);
	g.movetype = MOVETYPE_BOUNCE;
	g.solid = SOLID_TRIGGER;
	if ((autocvar_kickgibs == 1))
		g.touch = kick_touch;
	else
		g.touch = kick_touch3;
	g.avelocity_x = crandom() * 520;
	g.avelocity_y = crandom() * 520;
	g.avelocity_z = crandom() * 520;
	if (keep_colormap)
		g.colormap = self.colormap;
	g.traileffectnum = particleeffectnum("TR_BLOOD");
	g.frame = 0;
	g.flags = 0;
	g.alpha = 1;
	g.scale = 1;
	if ((autocvar_gibsduration == 0))
	{
		g.nextthink = -1;
	}
	else
	{
		gibsfadetime = autocvar_gibsduration;
		if ((autocvar_gibsexplode == 0))
		{
			g.think = gibsfade_noblood;
			g.ltime = time;
			g.nextthink = ((time + gibsfadetime) + (random() * 8));
		}
		else
		{
			precache_sound("player/gibexplode.wav");
			g.think = gibsfade_blood;
			g.ltime = time;
			g.nextthink = ((time + gibsfadetime) + (random() * 8));
		}
	}
	GibPhysics(g);
};

vector() PD_KnockbackDir =
{
	local vector dir;

	if (((self.enemy != world) && (self.enemy != self)))
	{
		dir = self.origin - self.enemy.origin;
		dir_z = 0;
		if ((vlen(dir) > 4))
		{
			dir = normalize(dir);
			self.angles_y = vectoyaw(-dir);
			return dir;
		}
	}
	makevectors(self.angles);
	dir = -v_forward;
	dir_z = 0;
	if ((vlen(dir) < 0.1))
		dir = '-1 0 0';
	return normalize(dir);
};

void() PD_AnimTick =
{
	if ((self.deadflag != DEAD_DYING))
		return;

	if ((self.pd_anim == 3))
	{
		if (((self.pd_gib_flags & 1) && (self.frame >= PD_LIMBS_OFF_GIB_ARM_F)))
		{
			self.pd_gib_flags = (self.pd_gib_flags - (self.pd_gib_flags & 1));
			PD_SpawnClassicGib("progs/gib_id1_arm_l.mdl", '-2 9 12', '45 140 210', TRUE);
			PD_SpawnClassicGib("progs/gib_id1_arm_r.mdl", '-2 -9 12', '-35 -145 220', TRUE);
			pointparticles(particleeffectnum("blood_spurt"), self.origin + '0 0 12', '0 0 60', 1);
			sound7(self, CHAN_AUTO, "misc/corpsegib.wav", 1, ATTN_NORM, SNDSPD);
		}
		if (((self.pd_gib_flags & 2) && (self.frame >= PD_LIMBS_OFF_GIB_LEG_F)))
		{
			self.pd_gib_flags = (self.pd_gib_flags - (self.pd_gib_flags & 2));
			PD_SpawnClassicGib("progs/gib_id1_leg_l.mdl", '2 5 -10', '115 90 175', TRUE);
			PD_SpawnClassicGib("progs/gib_id1_leg_r.mdl", '-2 -5 -10', '-110 -85 185', TRUE);
			pointparticles(particleeffectnum("blood_spurt"), self.origin - '0 0 6', '0 0 50', 1);
			sound7(self, CHAN_VOICE, "player/gib.wav", 1, ATTN_NORM, SNDSPD);
		}
	}
	else if ((self.pd_anim == 4))
	{
		if (((self.pd_gib_flags & 4) && (self.frame >= (PD_HEAD_OFF_START + 1))))
		{
			self.pd_gib_flags = (self.pd_gib_flags - (self.pd_gib_flags & 4));
			PD_SpawnClassicGib("progs/h_player_id1.mdl", '0 0 22', '35 20 275', FALSE);
			pointparticles(particleeffectnum("blood_spurt"), self.origin + '0 0 22', '0 0 120', 1);
			sound7(self, CHAN_AUTO, "misc/corpsegib.wav", 1, ATTN_NORM, SNDSPD);
		}
	}
	else if ((self.pd_anim == 2))
	{
		if ((time < self.pd_slide_t))
		{
			if (((self.frame >= (PD_GUT_SLIDE_START + 10)) || (self.flags & FL_ONGROUND)))
			{
				if ((vlen(self.pd_slide_vel) > 25))
				{
					self.flags = (self.flags - (self.flags & FL_ONGROUND));
					self.velocity_x = self.pd_slide_vel_x;
					self.velocity_y = self.pd_slide_vel_y;
					if ((self.velocity_z < -40))
						self.velocity_z = -40;
					self.pd_slide_vel = (self.pd_slide_vel * 0.88);
				}
			}
		}
	}

	if ((self.frame < self.pd_end_frame))
	{
		self.frame = (self.frame + 1);
		self.think = PD_AnimTick;
		self.nextthink = (time + 0.05);
		return;
	}

	if (((self.pd_anim == 2) && (time < self.pd_slide_t) && (vlen(self.pd_slide_vel) > 35)))
	{
		self.think = PD_AnimTick;
		self.nextthink = (time + 0.05);
		return;
	}

	PlayerDead();
};

float() PD_PickAnim =
{
	local float forced, w, spd, r;

	forced = cvar("bm_death_anim");
	if ((forced >= 1 && forced <= 6))
		return floor(forced);

	// 25% chance to play one of the classic 1996 diea..diee animations (unless heavy overkill)
	if ((self.health >= -40))
	{
		if ((random() < 0.25))
			return 0;
	}

	w = self.enemy.weapon;
	spd = vlen(self.velocity);
	r = random();

	if (((w == IT_ROCKET_LAUNCHER) || (w == IT_GRENADE_LAUNCHER) || (spd > 240)))
	{
		if (r < 0.30) return 2; // gut_slide
		if (r < 0.56) return 1; // ko_spin
		if (r < 0.80) return 5; // backflip
		return 3;               // limbs_off
	}
	if (((w == IT_SHOTGUN) || (w == IT_SUPER_SHOTGUN)))
	{
		if (r < 0.30) return 4; // head_off
		if (r < 0.55) return 3; // limbs_off
		if (r < 0.80) return 2; // gut_slide
		return 5;               // backflip
	}
	if (((w == IT_LIGHTNING) || (w == IT_LASER_CANNON)))
	{
		if (r < 0.55) return 6; // spasm
		if (r < 0.78) return 4; // head_off
		return 1;               // ko_spin
	}

	// Balanced multiplayer mix across all 6 new deaths
	if (r < 0.18) return 1;
	if (r < 0.36) return 2;
	if (r < 0.53) return 3;
	if (r < 0.70) return 4;
	if (r < 0.85) return 5;
	return 6;
};

float() PD_TryCustomPlayerDeath =
{
	local float anim, cls;
	local vector dir;

	if ((self.model != "progs/player_id1.mdl"))
		return FALSE;

	anim = PD_PickAnim();
	if ((anim == 0))
	{
		cls = 1 + floor(random() * 5);
		if (cls == 1) player_diea1();
		else if (cls == 2) player_dieb1();
		else if (cls == 3) player_diec1();
		else if (cls == 4) player_died1();
		else player_diee1();
		return TRUE;
	}

	self.pd_anim = anim;
	self.pd_gib_flags = 0;
	self.pd_slide_vel = '0 0 0';
	self.pd_slide_t = 0;
	self.flags = (self.flags - (self.flags & FL_ONGROUND));
	self.movetype = MOVETYPE_TOSS;

	if ((anim == 1))
	{
		// KO air spin
		dir = PD_KnockbackDir();
		self.velocity = (dir * 200) + '0 0 265';
		self.frame = PD_KO_SPIN_START;
		self.pd_end_frame = PD_KO_SPIN_END;
	}
	else if ((anim == 2))
	{
		// Gut-fold fly across map & slide
		dir = PD_KnockbackDir();
		self.pd_slide_vel = dir * 620;
		self.pd_slide_t = time + 1.65;
		self.velocity = (dir * 620) + '0 0 190';
		self.frame = PD_GUT_SLIDE_START;
		self.pd_end_frame = PD_GUT_SLIDE_END;
	}
	else if ((anim == 3))
	{
		// Legs and arms blow off
		self.pd_gib_flags = 3;
		self.velocity = (self.velocity * 0.4) + '0 0 110';
		self.frame = PD_LIMBS_OFF_START;
		self.pd_end_frame = PD_LIMBS_OFF_END;
	}
	else if ((anim == 4))
	{
		// Head blows off and falls down
		self.pd_gib_flags = 4;
		self.velocity = (self.velocity * 0.3) + '0 0 60';
		self.frame = PD_HEAD_OFF_START;
		self.pd_end_frame = PD_HEAD_OFF_END;
	}
	else if ((anim == 5))
	{
		// Wild backflip pancake splat
		dir = PD_KnockbackDir();
		self.velocity = (dir * 235) + '0 0 325';
		self.frame = PD_BACKFLIP_START;
		self.pd_end_frame = PD_BACKFLIP_END;
	}
	else
	{
		// Violent jitter-spasm collapse
		self.velocity = (self.velocity * 0.2);
		self.frame = PD_SPASM_START;
		self.pd_end_frame = PD_SPASM_END;
	}

	self.think = PD_AnimTick;
	self.nextthink = (time + 0.05);
	return TRUE;
};

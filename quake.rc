// BakersfieldQuake (Bakersfield LAN) - replaces q15.pk3's quake.rc
// Same as Combat+'s, except: BakersfieldQuake's own intro demo, the multiplayer settings (q15_config_coop.cfg) instead of the
// single-player ones, and they run BEFORE config.cfg so a player's own saved settings always win.

// Combat+ multiplayer settings, and the hook aliases
exec q15_config_coop.cfg
exec hook.cfg

// mod defaults and clean modern binds/settings for a brand new player. AFTER q15_config_coop.cfg so the mod's own values
// win over Combat+'s (it set r_coronas 0.4 and enforcer_defender_prox 1 over ours); still before config.cfg.
exec default.cfg

// client look/feel defaults (also before config.cfg, so the player's own choices win)
sbar_alpha_bg "0"
cl_decals "1"
cl_decals_max "256"
cl_decals_time "16"
cl_decals_fadetime "4"
cl_decals_models "0"
cl_stainmaps "0"
showfps "1"
effects_classic_explosion "1"
r_lerplightstyles "1"
cl_beams_instantaimhack "1"
cl_beams_lightatend "1"
cl_beams_polygons "0"
r_lightningbeam_color_blue "0.7"
r_lightningbeam_color_green "0.6"
r_lightningbeam_color_red "0.5"
r_lightningbeam_qmbtexture "1"
r_lightningbeam_repeatdistance "256"
r_lightningbeam_scroll "6"
r_lightningbeam_thickness "8"
rate "95000"
cl_movement_track_canjump 0
gl_texturecompression "0"
seta weaponautoswitch 0		// picking up a gun never yanks the one you are holding (Combat+ sets 3 above)

// defaults only (seta = saved). config.cfg below wins, so a change made in game is kept.
exec autoexec.cfg

// the player's saved settings (written by the game on quit): binds, resolution, name, sensitivity, graphics menu...
// (a new player gets a placeholder config.cfg from the zip; without it the game would load Combat+'s own inside q15.pk3:
//  inverted mouse, loud music, its own keys)
seta bm_defver 0
exec config.cfg

// per-client demo recording is server-config only (VPS): a 1 saved by an old Host session must not stick
sv_autodemo_perclient 0

// always start with mouse look on: test runs can save vid_mouse 0 / freelook 0 / -mlook into config.cfg.
// Command-line overrides (+vid_mouse 0, +freelook 0, -window...) still win (stuffcmds / engine -window below).
vid_mouse 1
freelook 1
+mlook

// optional local-only post-config guard (never shipped in LAN zip / web pack), mirroring personal.cfg
exec personal_post.cfg

// default keys and one-shot setting migrations, never touching a player's own binds afterwards. bm_defver is saved in
// config.cfg. bm_up_N means "upgrade a player who is at version N". A brand new player (0) gets bm_binds.cfg; anyone
// below 12 gets the folded v1-v12 history (bm_up_legacy.cfg) once.
// To ship a new migration: write bm_up_14.cfg, change bm_up_13 to "exec bm_up_14.cfg; bm_up_14", and add
// alias bm_up_14 "seta bm_defver 14". One line and one file per migration, the chain stays linear.
alias bm_old "exec bm_up_legacy.cfg; bm_up_12"
alias bm_up_0 "exec bm_binds.cfg; bm_old"
alias bm_up_1 bm_old
alias bm_up_2 bm_old
alias bm_up_3 bm_old
alias bm_up_4 bm_old
alias bm_up_5 bm_old
alias bm_up_6 bm_old
alias bm_up_7 bm_old
alias bm_up_8 bm_old
alias bm_up_9 bm_old
alias bm_up_10 bm_old
alias bm_up_11 bm_old
alias bm_up_12 "exec bm_up_13.cfg; bm_up_13"
alias bm_up_13 "seta bm_defver 13"
bm_up_$bm_defver

// Build no unused unvised BSP portals, or spam debug prints unless overridden on command line
mod_bsp_portalize "0"
developer "0"

// command line (+map, +connect, +exec warmup.cfg / server.cfg ...)
stuffcmds

//DP specifics (from Combat+'s quake.rc)
sv_gameplayfix_noairborncorpse 1
sv_gameplayfix_setmodelrealbox 1
sv_gameplayfix_slidemoveprojectiles 1

// Startup main menu & slow scenic map background are driven by menu.dat (menu_background / menu_background_map).

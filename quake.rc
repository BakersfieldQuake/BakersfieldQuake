// BakersfieldQuake (Bakersfield LAN) - replaces q15.pk3's quake.rc
// Same as Combat+'s, except: BakersfieldQuake's own intro demo, the multiplayer settings (q15_config_coop.cfg) instead of the
// single-player ones, and they run BEFORE config.cfg so a player's own saved settings always win.

// Combat+ multiplayer settings, and the hook aliases
exec q15_config_coop.cfg
exec hook.cfg

// mod defaults and clean modern binds/settings for a brand new player. AFTER q15_config_coop.cfg so the mod's own values
// win over Combat+'s (it set r_coronas 0.4 and enforcer_defender_prox 1 over ours); still before config.cfg.
exec default.cfg
loadfont menu engine/fonts/Roboto-Medium.ttf 8 12 16 24 32

// client look/feel defaults (also before config.cfg, so the player's own choices win)
sbar_alpha_bg "0"
cl_decals "1"
cl_decals_max "256"
cl_decals_time "16"
cl_decals_fadetime "4"
cl_decals_models "0"
cl_stainmaps "0"
showfps "1"
showdate "1"				// bottom right: the release this game data comes from (version.cfg below). showdate 0 hides it
effects_classic_explosion "1"
r_lerplightstyles "1"
cl_beams_instantaimhack "1"
cl_beams_lightatend "1"
cl_beams_polygons "0"
r_lightningbeam_color_blue "0.7"
r_lightningbeam_color_green "0.6"
r_lightningbeam_color_red "0.5"
r_lightningbeam_qmbtexture "1"
r_lightningbeam_repeatdistance "256"
r_lightningbeam_scroll "6"
r_lightningbeam_thickness "8"
rate "95000"
cl_movement_track_canjump 0
gl_texturecompression "0"
seta weaponautoswitch 0		// picking up a gun never yanks the one you are holding (Combat+ sets 3 above)

// defaults only (seta = saved). config.cfg below wins, so a change made in game is kept.
exec autoexec.cfg

// the player's saved settings (written by the game on quit): binds, resolution, name, sensitivity, graphics menu...
// (a new player gets a placeholder config.cfg from the zip; without it the game would load Combat+'s own inside q15.pk3:
//  inverted mouse, loud music, its own keys)
seta bm_defver 0
exec config.cfg

// the release tag, shown by showdate (its format is plain text with no % codes). Written by build-zip.yml; AFTER
// config.cfg because showdate_format is saved there and an old value would win.
exec version.cfg

// per-client demo recording is server-config only (VPS): a 1 saved by an old Host session must not stick
sv_autodemo_perclient 0

// gib physics ("Gyro") off for hosted games. Each gib ran about 8 QC calls on EVERY server frame for its whole 30-40 s life:
// measured 2026-11-18 on soi6 with 15 bots, Gyro was 61% of all server QC work (1089M of 1785M statements in 75 s) and the
// host's client lost a quarter of its frame rate. Gibs still fly and bounce (engine physics); they only stop floating and
// tumbling. Combat+ saves gyroset 2 into config.cfg, so it is set here, after config.cfg. To get it back: gyroset 2 in
// personal_post.cfg (or in the console after start).
gyroset 0

// Zircon's own autosave ("Automatic save game every 90 seconds") also runs during deathmatch and froze listen hosts for
// 60-130 ms every 90 s (audit 2026-11-23, "Auto-saved." on the worst frame of 13 of 19 bot matches). Combat+ keeps its own
// single-player autosave (QuakeC auto_save), so the engine one is redundant. After config.cfg so a saved 1 can't undo it.
sv_autosave 0

// free the old map before loading the next one. Without it one session grew from 2.1 GB to 4.1 GB committed over 19 map
// changes (audit 2026-11-23); the low-memory tiers already set it.
mod_freebeforeload 1

// load the Wheelman Cannon sprites with the map: the first charge otherwise froze the host ~170 ms (audit 2026-11-23).
// lowmem.cfg / lowgpu.cfg (passed by the launchers on small PCs, after this file) set it back to 0. server.cfg sets 1.
set bm_preload 1

// always start with mouse look on: test runs can save vid_mouse 0 / freelook 0 / -mlook into config.cfg.
// Command-line overrides (+vid_mouse 0, +freelook 0, -window...) still win (stuffcmds / engine -window below).
vid_mouse 1
freelook 1
+mlook

// optional local-only post-config guard (never shipped in LAN zip / web pack), mirroring personal.cfg
exec personal_post.cfg

// default keys and one-shot setting migrations, never touching a player's own binds afterwards. bm_defver is saved in
// config.cfg. bm_up_N means "upgrade a player who is at version N". A brand new player (0) gets bm_binds.cfg and jumps
// straight to the latest version (skipping legacy unbinds in bm_up_legacy.cfg); anyone at 1..11 gets the folded v1-v12
// history (bm_up_legacy.cfg) once, then steps through bm_up_13/14.
// To ship a new migration: write bm_up_15.cfg, change bm_up_14 to "exec bm_up_15.cfg; bm_up_15", and add
// alias bm_up_15 "seta bm_defver 15" (plus update bm_binds.cfg for new players). One line and one file per migration.
alias bm_old "exec bm_up_legacy.cfg; bm_up_12"
alias bm_up_0 "exec bm_binds.cfg; bm_up_14"
alias bm_up_1 bm_old
alias bm_up_2 bm_old
alias bm_up_3 bm_old
alias bm_up_4 bm_old
alias bm_up_5 bm_old
alias bm_up_6 bm_old
alias bm_up_7 bm_old
alias bm_up_8 bm_old
alias bm_up_9 bm_old
alias bm_up_10 bm_old
alias bm_up_11 bm_old
alias bm_up_12 "exec bm_up_13.cfg; bm_up_13"
alias bm_up_13 "exec bm_up_14.cfg; bm_up_14"
alias bm_up_14 "seta bm_defver 14"
bm_up_$bm_defver

// Always start in FPS bindmap 0, and re-apply user vehicle_binds.cfg if present (survives bm_binds.cfg unbindall)
in_bindmap 0 0
// the menu saves it with fopen, which writes under data/ (audit 2026-11-23, MN-01)
exec data/vehicle_binds.cfg

// Build no unused unvised BSP portals, or spam debug prints unless overridden on command line
mod_bsp_portalize "0"
developer "0"

// command line (+map, +connect, +exec warmup.cfg / server.cfg ...)
stuffcmds

//DP specifics (from Combat+'s quake.rc)
sv_gameplayfix_noairborncorpse 1
sv_gameplayfix_setmodelrealbox 1
sv_gameplayfix_slidemoveprojectiles 1

// Startup main menu & slow scenic map background are driven by menu.dat (menu_background / menu_background_map).
